# Copy this file to .env and change the values. Never commit the real .env file.

# Database. Leave empty for a local SQLite file. On Render this is filled in for you.
# Example for Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./p5test.db

# Used to sign the facilitator login token. Use a long random string.
SECRET_KEY=change-this-to-a-long-random-string

# Facilitator dashboard password.
ADMIN_PASSWORD=change-this-password

# Test length in seconds (7200 = 2 hours) and the extra seconds allowed for slow networks.
TEST_DURATION_SECONDS=7200
GRACE_SECONDS=20

# Only needed if the frontend runs on a different address and calls the API directly.
CORS_ORIGINS=
